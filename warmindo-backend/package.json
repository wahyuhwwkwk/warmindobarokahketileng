    "version": "1.0.0",
    "description": "API dan Realtime Server untuk Warmindo Barokah",
    "main": "src/server.ts",
    "scripts": {
        "start": "ts-node src/server.ts",
        "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
