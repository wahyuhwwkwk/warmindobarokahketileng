        "db:seed": "ts-node prisma/seed.ts",
        "db:studio": "prisma studio"
    },
    "prisma": {
        "seed": "ts-node prisma/seed.ts"
    },
    "dependencies": {
        "@prisma/client": "^5.10.2",
        "@types/multer": "^2.2.0",
        "cors": "^2.8.5",
        "express": "^4.18.3",
        "midtrans-client": "^1.4.3",
        "multer": "^2.2.0",
        "socket.io": "^4.7.4"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.11.24",
        "prisma": "^5.10.2",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.3.3"
    }
